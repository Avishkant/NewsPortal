# Example environment variables for the client (do NOT commit real secrets)
# Vite requires env vars exposed to the client to start with `VITE_`.
# Set this to the publicly reachable backend URL used in production (no trailing slash).
VITE_BACKEND_URL=https://api.example.com

# Optional: override the public base path used by Vite preview/build if needed
# VITE_PUBLIC_PATH=/
